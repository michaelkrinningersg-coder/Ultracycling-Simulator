# Erzeugte Spieldaten: Fahrerpool und gerechnete Rennen entstehen aus
# Seed und Strecke neu und gehören nicht ins Repository.
data/pool.json
data/races/
data/seasons/

# Die fertigen Strecken werden dagegen mitgeliefert – die EXE braucht
# kein Netz und keinen Kartendienst (Abschnitt 16).
!data/routes/

# Die Demo-GPX-Dateien nicht: 5 MB, die aus einem Seed in einer Sekunde
# neu entstehen (python tools/make_demo_gpx.py --all).
data/gpx/

# Die GPX-Zwischenstufe nicht: Sie ist Eingabe des Importers, nicht
# Ergebnis. Aus tools/make_demo_gpx.py entsteht sie jederzeit neu, und
# 29 MB Textdatei neben 2 MB fertigen Strecken wären reiner Ballast.
data/gpx/
